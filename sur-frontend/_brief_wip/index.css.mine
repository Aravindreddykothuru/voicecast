@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap');
@import 'tailwindcss';
@import './styles/tokens.css';

@theme {
  --font-sans: 'DM Sans', sans-serif;
}

html,
body,
#root {
  height: 100%;
  background: var(--bg-app);
  color: var(--text-primary);
  font-family: var(--font);
}

* {
  font-family: inherit;
}

/* Typography scale -- see src/styles/tokens.css. Every screen composes these
   instead of picking its own font-size/weight. */
.text-page-title {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
}

.text-section-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.3;
}

.text-body {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
}

.text-label {
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
}

.text-meta {
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--text-muted);
}

.panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-panel);
}

.btn-primary {
  background: var(--accent);
  color: var(--text-on-accent);
  border-radius: var(--r-md);
  font-size: 14px;
  font-weight: 500;
  padding: 10px 16px;
  transition: background-color 0.15s ease;
}

.btn-primary:hover:not(:disabled) {
  background: var(--accent-hover);
}

.btn-primary:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-secondary {
  background: var(--bg-panel);
  color: var(--text-primary);
  border: 1px solid var(--border-strong);
  border-radius: var(--r-md);
  font-size: 14px;
  font-weight: 500;
  padding: 10px 16px;
  transition: background-color 0.15s ease;
}

.btn-secondary:hover:not(:disabled) {
  background: var(--bg-hover);
}

.btn-secondary:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
