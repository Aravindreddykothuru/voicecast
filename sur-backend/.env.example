# ---------------------------------------------------------------------------
# Sur backend — environment configuration
# Copy to .env for local docker-compose use: cp .env.example .env
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=sur-backend
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443

# --- Database ---
DATABASE_URL=postgresql+psycopg2://sur:sur@postgres:5432/sur
# Async URL used by anything running under asyncio (kept in sync with above)
ASYNC_DATABASE_URL=postgresql+asyncpg://sur:sur@postgres:5432/sur

# --- Redis (Celery broker/result backend + pub/sub for WebSocket events) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (S3-compatible; defaults target the bundled MinIO) ---
# 'local' writes to ./data/storage, no MinIO/S3 needed (routes_storage.py).
STORAGE_BACKEND=local
# Only needed for MinIO/R2/another S3-compatible store. Omit both entirely
# for real AWS S3 -- unset means "use AWS's own endpoint for STORAGE_REGION".
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=sur_minio
STORAGE_SECRET_KEY=sur_minio_secret
STORAGE_BUCKET=sur-media
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
# STORAGE_BACKEND=local only; relative paths anchor at the backend directory.
LOCAL_STORAGE_ROOT=data/storage

# --- Media tooling ---
# Bare names resolve on PATH. On a native Windows checkout without ffmpeg on
# PATH, point at the binaries (relative paths anchor at the backend dir):
#   FFMPEG_BINARY=.tools/ffmpeg-9.0.1-essentials_build/bin/ffmpeg.exe
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- Provider selection ---
# Each stage can be "mock" (default -- fast, deterministic, no GPU/model
# downloads, ideal for frontend integration and CI) or "real" (loads the
# actual model; requires requirements-ml.txt and usually a GPU).
ASR_PROVIDER=mock
DIARIZATION_PROVIDER=mock
TRANSLATION_PROVIDER=mock
EMOTION_PROVIDER=mock
TTS_PROVIDER=mock

# Real-provider knobs (only read when the corresponding *_PROVIDER=real)
ASR_MODEL_NAME=large-v3
# 'auto' detects the source language per chunk. Pin a code (en, hi, ...) when
# the source language is known -- faster and more accurate on short chunks.
ASR_LANGUAGE=auto
ASR_DEVICE=cuda
TRANSLATION_MODEL_NAME=ai4bharat/indictrans2-en-indic-1B
TRANSLATION_INDIC_EN_MODEL_NAME=ai4bharat/indictrans2-indic-en-1B
TRANSLATION_INDIC_INDIC_MODEL_NAME=ai4bharat/indictrans2-indic-indic-1B
# --- Text-to-speech (CONTRACTS.md #7) ---
# TTS_ENGINE picks the renderer; voices and their licenses per language live
# in app/capabilities.py and are published in /api/capabilities.
#   syspin  SYSPIN VITS (IISc), CC-BY-4.0 -- commercial use allowed WITH
#           attribution. te, hi, kn, mr, bn; male and female voices.
#   mms     facebook/mms-tts, CC-BY-NC-4.0 -- NON-COMMERCIAL. All 11 languages
#           (Urdu was dropped 2026-09-23: no TTS model the licence policy
#           allows speaks it).
TTS_ENGINE=syspin
# true: only commercially licensed voices are offered (languages without one
# report tts_available=false) and a non-commercial engine refuses to start.
# Only set false for research / non-commercial deployments.
TTS_REQUIRE_COMMERCIAL_LICENSE=true
# Feature flag, off by default: renders the raw SYSPIN audio in an isolated
# subprocess (app/tts_runtime) instead of in-process, so a crash or hang in
# the render can no longer take the whole worker down. Proven byte-identical
# to the in-process path on a fixed sample set. One-line rollback: false.
TTS_USE_RUNTIME=false
TTS_MMS_MODEL_PREFIX=facebook/mms-tts-
# Voice cloning (a project's clone_voice): re-voices the rendered speech as
# the original speaker. openvoice = OpenVoice V2 tone-colour converter (MIT);
# cosyvoice = CosyVoice2 voice conversion (slow on CPU). The converter must
# pass a startup budget (TTS_VOICE_CLONE_MAX_RTF, content preservation) or
# the TTS worker refuses to start.
TTS_VOICE_CLONE=false
TTS_VOICE_CLONE_ENGINE=openvoice
TTS_VOICE_CLONE_MAX_RTF=4.0
# Source checkouts put on sys.path by the providers. Leave unset where
# PYTHONPATH already carries them (Dockerfile.worker-tts).
# OPENVOICE_SRC_DIR=.tools/OpenVoice
# COSYVOICE_SRC_DIR=.tools/CosyVoice
TTS_MODEL_NAME=.tools/models/CosyVoice2-0.5B
TTS_DEVICE=cuda

# --- Liveness ---
# Workers heartbeat every HEARTBEAT_INTERVAL_SECONDS while a task runs; a
# queued/processing run silent for STALL_AFTER_SECONDS is reported stalled
# (ProjectRead.stalled) and POST /process may restart it.
HEARTBEAT_INTERVAL_SECONDS=20
STALL_AFTER_SECONDS=300
# Must be a checkpoint whose classification head loads under the installed
# transformers -- see CONTRACTS.md #1. Verified: superb/*-superb-er.
EMOTION_MODEL_NAME=superb/wav2vec2-base-superb-er
# Predictions below this are shown as "uncertain" rather than as a label.
# Served via /api/capabilities so the UI never hardcodes its own threshold.
EMOTION_CONFIDENCE_FLOOR=0.4

# --- Secrets: NOT stored here ---
# HF_TOKEN is deliberately absent from this file. It is a long-lived
# credential and is read from the process environment at run time
# (app/config.py: hf_token()). Only DIARIZATION_PROVIDER=real and
# TRANSLATION_PROVIDER=real need it. Export it before starting the worker:
#   PowerShell:  $env:HF_TOKEN = "hf_..."
#   bash:        export HF_TOKEN=hf_...
# Rotation instructions: see README.md "Rotating the Hugging Face token".
# Once the weights are cached, HF_HUB_OFFLINE=1 (also a process env var,
# read by huggingface_hub itself) loads them with no token and no network --
# scripts/run-local.ps1 -Offline sets it.

# --- Pipeline defaults ---
DEFAULT_TARGET_LANGUAGE=te
SYNC_TOLERANCE_PCT=10

# --- Upload limits ---
# Enforced server-side (routes_projects.py/routes_storage.py), not just
# advisory UI copy. Served via /api/capabilities.
MAX_UPLOAD_MB=2048
ACCEPTED_VIDEO_FORMATS=video/mp4,video/quicktime,video/x-matroska,video/webm

# --- Auth (stubbed for now; see app/core/security.py) ---
DEV_DEFAULT_USER_EMAIL=dev@sur.local
