# Same base image for CPU and GPU workers -- which stages a given worker
# container handles is decided at `docker-compose up` time via `celery -A
# app.celery_app worker -Q <queues>`, not by the image. To actually run the
# "real" providers on a GPU host, build on an nvidia/cuda base instead and
# additionally `pip install -r requirements-ml.txt` (see README "Running
# with real models").
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY tts_chains*.yaml ./
COPY known_bad ./known_bad

CMD ["celery", "-A", "app.celery_app", "worker", "--loglevel=INFO"]
